# Put these locations inside the HTTPS server block for your domain.
# Replace the exact /sub/... path with the SUB_PATH in gate.conf.
# The subscription URL is fixed and does not use a query-string token.

location = /sub-access {
    return 301 /sub-access/;
}

location ^~ /sub-access/ {
    proxy_pass http://127.0.0.1:18080;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    proxy_http_version 1.1;
    proxy_read_timeout 30s;
    access_log off;
}

location = /sub/replace-with-your-subscription-path {
    proxy_pass http://127.0.0.1:18080;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    proxy_http_version 1.1;
    proxy_read_timeout 30s;
    access_log off;
}

